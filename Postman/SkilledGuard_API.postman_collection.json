{
	"info": {
		"_postman_id": "skilledguard-api-001",
		"name": "SkilledGuard API",
		"description": "Colección de Postman para probar la API REST de SkilledGuard.\n\n**Instrucciones:**\n1. Importar esta colección en Postman.\n2. Configurar la variable de entorno `baseUrl` (por defecto: http://localhost:5164 o https://localhost:7086).\n3. Ejecutar primero **Auth > Login** para obtener el token JWT.\n4. El token se guarda en la variable `token` y se usa automáticamente en las peticiones que requieren autenticación.\n\n**Usuarios de prueba (tras ejecutar DML):**\n- Administrador: juan@correo.com / clave123\n- Usuario: ana@correo.com / clave456\n- Admin: admin@skilledguard.com / admin123\n- Usuario: usuario@skilledguard.com / user123",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5164"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('token', json.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"juan@correo.com\",\n  \"contraseña\": \"clave123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Auth", "login"]
						},
						"description": "Obtiene token JWT. No requiere autenticación. El token se guarda automáticamente en la variable `token`."
					}
				}
			]
		},
		{
			"name": "Usuario",
			"item": [
				{
					"name": "Listar usuarios",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/Usuario",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Usuario"]
						}
					}
				},
				{
					"name": "Obtener usuario por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/Usuario/dddddddd-dddd-dddd-dddd-dddddddddddd",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Usuario", "dddddddd-dddd-dddd-dddd-dddddddddddd"]
						}
					}
				},
				{
					"name": "Crear usuario",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombres\": \"Nuevo\",\n  \"apellidos\": \"Usuario\",\n  \"id_tipo_documento\": \"33333333-3333-3333-3333-333333333333\",\n  \"documento\": \"99887766\",\n  \"tipo_usuario\": \"user\",\n  \"email\": \"nuevo@correo.com\",\n  \"direccion\": \"Calle ejemplo\",\n  \"contraseña\": \"clave789\",\n  \"id_rol\": \"22222222-2222-2222-2222-222222222222\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Usuario",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Usuario"]
						}
					}
				},
				{
					"name": "Cambiar contraseña",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idUsuario\": \"dddddddd-dddd-dddd-dddd-dddddddddddd\",\n  \"contraseñaActual\": \"clave123\",\n  \"nuevaContraseña\": \"claveNueva123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Usuario/changePassword",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Usuario", "changePassword"]
						}
					}
				}
			]
		},
