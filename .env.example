# Copiar a .env y ajustar. El archivo .env NUNCA se sube al repositorio.

# Local (docker-compose). Para Supabase: la cadena de conexión del panel,
# cambiando el prefijo a postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://skilledguard:skilledguard@db:5432/skilledguard

# Generar uno propio:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambiar-por-un-secreto-generado
JWT_EXPIRACION_MINUTOS=60

# Credenciales del primer administrador (solo para `python -m app.seed`)
ADMIN_DOCUMENTO=1000000000
ADMIN_CONTRASENA=
